@unpublished{pushkin2026fwcc,
  title     = {FwCC: An FRB--Galaxy Cross-Correlation Pipeline and its Application to CHIME/FRB and DESI DR1},
  author    = {Pushkin, Anton},
  year      = {2026},
  month     = {September},
  note      = {Under Review at The Astrophysical Journal},
  abstract  = {Fast radio bursts (FRBs) trace the ionised baryon content of the Universe through their dispersion measures (DMs), but inferring cosmological parameters from DM requires assumptions about the baryon distribution and the host-galaxy contribution. We present the FRB--w Cross-Correlation (FwCC) pipeline, a method for measuring the angular cross-correlation between the extragalactic FRB DM field and foreground galaxy overdensity maps without assigning point redshifts to individual bursts. Applied to 4,450 FRBs from CHIME/FRB Catalogue 2 and DESI DR1 tracers, the pipeline yields constraints on the dark energy equation-of-state parameter ($w=-1.47\pm0.43$) and the ionised baryon fraction ($f_{\rm IGM}=0.69\pm0.06$) that are consistent with $\Lambda$CDM.},
  selected  = {true},
  code      = {https://github.com/AntonPushkin260/fwcc-analysis},
  doi       = {10.5281/zenodo.22725659}
}

@misc{pushkin2026resolving,
  title     = {Resolving the Dark Energy Crisis with Fast Radio Bursts: A w-Measurement from CHIME and SDSS Cross-Correlation},
  author    = {Pushkin, Anton},
  year      = {2026},
  publisher = {Zenodo},
  doi       = {10.5281/zenodo.19200364},
  url       = {https://doi.org/10.5281/zenodo.19200364},
  abstract  = {Early exploration of FRB--galaxy cross-correlation methods using CHIME/FRB Catalogue 1 and SDSS galaxy tracers. This work introduced the basic formalism of the FwCC method and demonstrated feasibility on smaller datasets.}
}
